GEMINI_API_KEY=your_gemini_key
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=apodex/apodex-1.1-mini:free
KIE_API_KEY=your_kie_ai_key

# Used to make the generated local PNG available to Instagram over HTTPS.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# Instagram Graph API token for an Instagram Professional account.
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token

# LinkedIn member or organization publishing.
# Example: urn:li:person:123456789 or urn:li:organization:123456789
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_AUTHOR_URN=urn:li:person:your_linkedin_id
LINKEDIN_VERSION=202601

# MySQL database
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=Kk@436243
MYSQL_DATABASE=marketai

# JWT secret (auto-generated if not set, but set this for persistence across restarts)
JWT_SECRET=change_this_to_a_random_secret_string
